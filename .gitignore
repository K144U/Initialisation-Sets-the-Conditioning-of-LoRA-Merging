# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/
env/

# LaTeX build artifacts
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
*.bbl
*.blg
*.bcf
*.run.xml
*.nav
*.snm
*.vrb
*.lof
*.lot
*.idx
*.ilg
*.ind

# OS / IDE
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
.idea/
.vscode/

# Claude Code / local agent state
.claude/

# Phase 3 generated artifacts (regenerable from configs + LoRA adapters)
cache/
logs/
.conda/
results/phase3/smoke/
code/phase3/figures/

# Large binaries / caches — too heavy for git (use external artifact
# storage or git-lfs if these ever need tracking).
# ~111 GB downloaded base models (not ours):
models/
# ~3.8 GB trained LoRA adapters + trainer checkpoints:
artifacts/
# Unsloth JIT cache:
unsloth_compiled_cache/
# Safety net: never commit raw weights:
*.safetensors
# Bulky raw per-example NLL arrays (~100 MB); their derived bootstrap CIs
# and aggregate matrices ARE committed under results/phase3/:
results/phase3/eval_matrix_n1k_v3_perexample/

# Secrets — never commit
.env
.env.local
*.token

# Misc
*.tmp
*.bak

# Orchestrator runtime state (sentinels + GPU pin overrides + retry state)
_*_COMPLETE
_ORCH_GPUS*
_QUEUE_*
_FISHER_COMPLETE
_RIDGE_COMPLETE
_RIDGE_XMODEL_COMPLETE

# Timestamped backup copies of orch state (post-incident snapshots)
*.bak.[0-9]*
*orchestrator*.bak.*

# Editor working files
_docedit*.py

# paper build output
paper/out/

# Submission package build outputs. The bundle is 19 MB and is rebuilt from
# history by build_anon_bundle.sh; committing it would embed each build inside
# the next one. The zips and the PDF are generated by make_zips.sh and
# overleaf/build.sh from the tracked sources.
tmlr_submission/supplementary/audit-trail.bundle
tmlr_submission/*.zip
tmlr_submission/paper.pdf
tmlr_submission/overleaf/out/

# Build artifact: regenerate with `python JAIR/sync_from_paper.py`. Committing
# it is how a 19 MB bundle got into history twice and tripled the repo size.
JAIR/overleaf_jair.zip

# TeX Live build outputs (JAIR/build_local.sh)
JAIR/overleaf/main.pdf
JAIR/overleaf/main.aux
JAIR/overleaf/main.bbl
JAIR/overleaf/main.bcf
JAIR/overleaf/main.blg
JAIR/overleaf/main.log
JAIR/overleaf/main.out
JAIR/overleaf/main.run.xml
JAIR/overleaf/main.synctex.gz
JAIR/overleaf/comment.cut
JAIR/overleaf/*.fls
JAIR/overleaf/*.fdb_latexmk

# Generated submission package: regenerate with `python JAIR/make_submission.py`.
# The PDF and zip are build outputs and would bloat the history; cover_letter.txt
# is derived from COVER_LETTER.md, which is itself kept out of the public mirror.
# SUBMIT.md is deliberately NOT ignored: it is the record of what was entered
# in the wizard.
JAIR/submission/*.pdf
JAIR/submission/*.zip
JAIR/submission/cover_letter.txt

# One exception, 2026-09-05. The manuscript PDF itself is tracked, so that a
# reader of the public repository can read the paper the commit trail belongs
# to without installing TeX Live to build it. It is 835 KB and is committed
# once per submitted version rather than once per build, which is what the
# paragraph above is actually guarding against. The zip stays ignored because
# the LaTeX sources it contains are already tracked under paper/ and JAIR/
# overleaf/, and cover_letter.txt stays ignored because it is correspondence.
!JAIR/submission/Pathak_Garg_Singh_Initialisation_LoRA_Merging.pdf
